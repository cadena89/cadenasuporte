# Copie para .env na pasta do servidor da API (ao lado do server.yaml). Nunca envie o .env para o Git.
RUSTDESK_API_DB_DRIVER=postgres
RUSTDESK_API_DB_DSN=postgres://cadenasuporte:TROQUE_A_SENHA@127.0.0.1:5432/cadenasuporte?sslmode=disable
RUSTDESK_API_SIGN_KEY=TROQUE_POR_32_OU_MAIS_CARACTERES_ALEATORIOS
# RUSTDESK_API_GRUPO_CLIENTES=Clientes
# Pastas onde o FTP recebe as gravacoes do Tecnico (separadas por ";"), para o botao Assistir do Registro de acessos
# RUSTDESK_API_PASTAS_GRAVACOES=D:\ftp\gravacoes
# Limpeza automatica, em dias (0 ou sem a linha = guarda para sempre)
# RUSTDESK_API_DIAS_REGISTROS=365
# RUSTDESK_API_DIAS_GRAVACOES=90
