diff --git a/backend/config/cadena.go b/backend/config/cadena.go
new file mode 100644
index 0000000..8c8c5fe
--- /dev/null
+++ b/backend/config/cadena.go
@@ -0,0 +1,107 @@
+package config
+
+// CadenaTech: opcoes proprias e configuracao por variaveis de ambiente.
+//
+// Segredos (DSN do banco com senha, signKey) podem ficar fora do server.yaml: num arquivo .env na pasta de
+// trabalho do servidor (fora do Git) ou em variaveis de ambiente, que tem prioridade sobre o .env:
+//   RUSTDESK_API_DB_DRIVER   sqlite | mysql | postgres
+//   RUSTDESK_API_DB_DSN      ex.: postgres://usuario:senha@127.0.0.1:5432/cadenasuporte?sslmode=disable
+//   RUSTDESK_API_SIGN_KEY    chave que assina os tokens
+//   RUSTDESK_API_GRUPO_CLIENTES  nome do grupo da aba "Grupo" do Tecnico (padrao "Clientes")
+
+import (
+	"bufio"
+	"os"
+	"path"
+	"strings"
+	"sync"
+)
+
+type CadenaConfig struct {
+	// Nome do grupo em que aparecem, na aba "Grupo" do Tecnico, os computadores dos clientes
+	GrupoClientes string `yaml:"grupoClientes"`
+}
+
+var (
+	dotEnvOnce sync.Once
+	grupoOnce  sync.Once
+	grupo      string
+)
+
+// carregarDotEnv le KEY=VALOR do .env da pasta de trabalho, sem trocar variaveis ja definidas
+func carregarDotEnv() {
+	dotEnvOnce.Do(func() {
+		f, err := os.Open(path.Join(wd, ".env"))
+		if err != nil {
+			return
+		}
+		defer f.Close()
+		s := bufio.NewScanner(f)
+		for s.Scan() {
+			linha := strings.TrimSpace(s.Text())
+			if linha == "" || strings.HasPrefix(linha, "#") {
+				continue
+			}
+			chave, valor, ok := strings.Cut(linha, "=")
+			if !ok {
+				continue
+			}
+			chave = strings.TrimSpace(strings.TrimPrefix(chave, "export "))
+			valor = strings.TrimSpace(valor)
+			if len(valor) >= 2 && (valor[0] == '"' && valor[len(valor)-1] == '"' || valor[0] == '\'' && valor[len(valor)-1] == '\'') {
+				valor = valor[1 : len(valor)-1]
+			}
+			if _, existe := os.LookupEnv(chave); !existe {
+				_ = os.Setenv(chave, valor)
+			}
+		}
+	})
+}
+
+// aplicarAmbiente troca os valores do server.yaml pelos do ambiente (e do .env). Chamado depois de gravar
+// o server.yaml padrao, para nenhum segredo do ambiente ir parar no arquivo
+func aplicarAmbiente(cfg *ServerConfig) {
+	carregarDotEnv()
+	if cfg.Db == nil {
+		cfg.Db = GetDefaultServerConfig().Db
+	}
+	if v := os.Getenv("RUSTDESK_API_DB_DRIVER"); v != "" {
+		cfg.Db.Driver = v
+	}
+	if v := os.Getenv("RUSTDESK_API_DB_DSN"); v != "" {
+		cfg.Db.Dsn = v
+	}
+	if v := os.Getenv("RUSTDESK_API_SIGN_KEY"); v != "" {
+		cfg.SignKey = v
+	}
+	if v := os.Getenv("RUSTDESK_API_GRUPO_CLIENTES"); v != "" {
+		if cfg.Cadena == nil {
+			cfg.Cadena = &CadenaConfig{}
+		}
+		cfg.Cadena.GrupoClientes = v
+	}
+	cfg.Db.Driver = NormalizarDriver(cfg.Db.Driver)
+}
+
+// NormalizarDriver aceita "postgresql"/"pgsql" como "postgres" (nome do driver lib/pq)
+func NormalizarDriver(driver string) string {
+	d := strings.ToLower(strings.TrimSpace(driver))
+	switch d {
+	case "postgresql", "pgsql", "pg":
+		return "postgres"
+	case "sqlite3":
+		return "sqlite"
+	}
+	return d
+}
+
+// GrupoClientes devolve o nome do grupo dos computadores dos clientes (lido uma vez)
+func GrupoClientes() string {
+	grupoOnce.Do(func() {
+		grupo = "Clientes"
+		if cfg := GetServerConfig(); cfg.Cadena != nil && strings.TrimSpace(cfg.Cadena.GrupoClientes) != "" {
+			grupo = strings.TrimSpace(cfg.Cadena.GrupoClientes)
+		}
+	})
+	return grupo
+}
