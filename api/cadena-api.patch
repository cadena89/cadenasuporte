new file mode 100644
index 0000000..3644a5b
--- /dev/null
+++ b/backend/cmd/migrar.go
@@ -0,0 +1,156 @@
+package cmd
+
+// CadenaTech: copia todos os dados de um banco para outro (ex.: SQLite -> PostgreSQL), mantendo ids e datas.
+//
+//   rustdesk-api-server-pro migrate-db --from-driver sqlite --from-dsn ./server.db \
+//     --to-driver postgres --to-dsn "postgres://usuario:senha@127.0.0.1:5432/cadenasuporte?sslmode=disable"
+//
+// O destino precisa estar vazio (tabelas inexistentes ou sem linhas). Sem --to-dsn, usa RUSTDESK_API_DB_DSN
+// (ambiente ou .env), para a senha nao aparecer na linha de comando. O fuso e o do server.yaml (db.timeZone).
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"rustdesk-api-server-pro/app/model"
+	"rustdesk-api-server-pro/config"
+	"time"
+
+	"github.com/spf13/cobra"
+	"xorm.io/xorm"
+	"xorm.io/xorm/schemas"
+)
+
+// modelos sao as tabelas da API, na mesma lista do "sync"
+func modelos() []interface{} {
+	return []interface{}{
+		new(model.User),
+		new(model.Peer),
+		new(model.Tags),
+		new(model.AuthToken),
+		new(model.Audit),
+		new(model.FileTransfer),
+		new(model.Device),
+		new(model.AddressBook),
+		new(model.AddressBookTag),
+		new(model.AddressBookRule),
+		new(model.MailLogs),
+		new(model.VerifyCode),
+		new(model.SystemSettings),
+		new(model.MailTemplate),
+	}
+}
+
+func abrirBanco(driver, dsn, fuso string) (*xorm.Engine, error) {
+	engine, err := xorm.NewEngine(config.NormalizarDriver(driver), dsn)
+	if err != nil {
+		return nil, err
+	}
+	if local, err := time.LoadLocation(fuso); err == nil {
+		engine.TZLocation = local
+		engine.DatabaseTZ = local
+	}
+	return engine, engine.Ping()
+}
+
+var migrarCmd = &cobra.Command{
+	Use:   "migrate-db",
+	Short: "Copy all data to another database (e.g. SQLite to PostgreSQL)",
+	RunE: func(cmd *cobra.Command, args []string) error {
+		cfg := config.GetServerConfig()
+		deDriver, _ := cmd.Flags().GetString("from-driver")
+		deDsn, _ := cmd.Flags().GetString("from-dsn")
+		paraDriver, _ := cmd.Flags().GetString("to-driver")
+		paraDsn, _ := cmd.Flags().GetString("to-dsn")
+		if deDriver == "" {
+			deDriver = "sqlite"
+		}
+		if deDsn == "" {
+			deDsn = "./server.db"
+		}
+		if paraDsn == "" {
+			paraDsn = os.Getenv("RUSTDESK_API_DB_DSN")
+		}
+		if paraDriver == "" || paraDsn == "" {
+			return fmt.Errorf("informe --to-driver e --to-dsn (ou RUSTDESK_API_DB_DSN)")
+		}
+		origem, err := abrirBanco(deDriver, deDsn, cfg.Db.TimeZone)
+		if err != nil {
+			return fmt.Errorf("origem: %w", err)
+		}
+		defer origem.Close()
+		destino, err := abrirBanco(paraDriver, paraDsn, cfg.Db.TimeZone)
+		if err != nil {
+			return fmt.Errorf("destino: %w", err)
+		}
+		defer destino.Close()
+
+		lista := modelos()
+		// O destino precisa estar vazio: nada e apagado nem sobrescrito
+		for _, m := range lista {
+			if existe, _ := destino.IsTableExist(m); existe {
+				if n, err := destino.Count(m); err == nil && n > 0 {
+					return fmt.Errorf("a tabela %s do destino ja tem %d linhas; use um banco vazio", destino.TableName(m), n)
+				}
+			}
+		}
+		if err := destino.Sync(lista...); err != nil {
+			return fmt.Errorf("criando as tabelas no destino: %w", err)
+		}
+
+		for _, m := range lista {
+			tabela := origem.TableName(m)
+			if existe, _ := origem.IsTableExist(m); !existe {
+				fmt.Printf("%-20s nao existe na origem\n", tabela)
+				continue
+			}
+			tipo := reflect.TypeOf(m).Elem()
+			linhas := reflect.New(reflect.SliceOf(tipo))
+			if err := origem.Find(linhas.Interface()); err != nil {
+				return fmt.Errorf("lendo %s: %w", tabela, err)
+			}
+			total := linhas.Elem().Len()
+			sessao := destino.NewSession()
+			if err := sessao.Begin(); err != nil {
+				sessao.Close()
+				return err
+			}
+			for i := 0; i < total; i++ {
+				// NoAutoTime: mantem created_at/updated_at da origem
+				if _, err := sessao.NoAutoTime().Insert(linhas.Elem().Index(i).Addr().Interface()); err != nil {
+					_ = sessao.Rollback()
+					sessao.Close()
+					return fmt.Errorf("gravando %s: %w", tabela, err)
+				}
+			}
+			if err := sessao.Commit(); err != nil {
+				sessao.Close()
+				return fmt.Errorf("gravando %s: %w", tabela, err)
+			}
+			sessao.Close()
+			// PostgreSQL: a sequencia do id continua do maior id copiado
+			if destino.Dialect().URI().DBType == schemas.POSTGRES && total > 0 {
+				q := fmt.Sprintf("SELECT setval(pg_get_serial_sequence('%s', 'id'), (SELECT MAX(id) FROM %s))",
+					destino.Quote(tabela), destino.Quote(tabela))
+				if _, err := destino.Exec(q); err != nil {
+					return fmt.Errorf("sequencia de %s: %w", tabela, err)
+				}
+			}
+			copiadas, _ := destino.Count(m)
+			fmt.Printf("%-20s %5d linhas copiadas (destino: %d)\n", tabela, total, copiadas)
+			if copiadas != int64(total) {
+				return fmt.Errorf("%s: a origem tem %d linhas e o destino ficou com %d", tabela, total, copiadas)
+			}
+		}
+		fmt.Println("Migracao concluida")
+		return nil
+	},
+}
+
+func init() {
+	migrarCmd.Flags().String("from-driver", "sqlite", "origem: sqlite | mysql | postgres")
+	migrarCmd.Flags().String("from-dsn", "./server.db", "origem: DSN")
+	migrarCmd.Flags().String("to-driver", "", "destino: sqlite | mysql | postgres")
+	migrarCmd.Flags().String("to-dsn", "", "destino: DSN (padrao: RUSTDESK_API_DB_DSN)")
+	RootCmd.AddCommand(migrarCmd)
+}
