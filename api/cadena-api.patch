diff --git a/backend/util/cadena_limite.go b/backend/util/cadena_limite.go
new file mode 100644
index 0000000..d0f2ed3
--- /dev/null
+++ b/backend/util/cadena_limite.go
@@ -0,0 +1,86 @@
+package util
+
+// CadenaTech: bloqueio temporario de login depois de muitas senhas erradas, por usuario + IP. Vale para o
+// login dos programas (/api/login) e do painel (/admin/auth/login). Fica em memoria: reiniciar a API zera.
+
+import (
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+)
+
+const (
+	LoginMaxFalhas = 5
+	LoginJanela    = 15 * time.Minute
+	LoginBloqueio  = 15 * time.Minute
+)
+
+type tentativaLogin struct {
+	falhas    int
+	primeira  time.Time
+	bloqueado time.Time
+}
+
+var (
+	tentativasLogin   = map[string]*tentativaLogin{}
+	tentativasLoginMu sync.Mutex
+)
+
+// ChaveLogin junta usuario e IP. Atras do tunel Cloudflare, o IP real vem em CF-Connecting-IP
+func ChaveLogin(usuario, ipCloudflare, ipConexao string) string {
+	ip := strings.TrimSpace(ipCloudflare)
+	if ip == "" {
+		ip = ipConexao
+	}
+	return strings.ToLower(strings.TrimSpace(usuario)) + "|" + ip
+}
+
+// LoginBloqueado diz se a chave esta bloqueada e, se estiver, a mensagem para mostrar
+func LoginBloqueado(chave string) (bool, string) {
+	tentativasLoginMu.Lock()
+	defer tentativasLoginMu.Unlock()
+	t, ok := tentativasLogin[chave]
+	if !ok || t.bloqueado.IsZero() {
+		return false, ""
+	}
+	resta := time.Until(t.bloqueado)
+	if resta <= 0 {
+		delete(tentativasLogin, chave)
+		return false, ""
+	}
+	minutos := int(resta.Minutes()) + 1
+	return true, fmt.Sprintf("Muitas tentativas de login. Tente de novo em %d minuto(s).", minutos)
+}
+
+// RegistrarFalhaLogin conta uma senha errada e bloqueia ao chegar no limite dentro da janela
+func RegistrarFalhaLogin(chave string) {
+	tentativasLoginMu.Lock()
+	defer tentativasLoginMu.Unlock()
+	agora := time.Now()
+	t, ok := tentativasLogin[chave]
+	if !ok || agora.Sub(t.primeira) > LoginJanela {
+		t = &tentativaLogin{primeira: agora}
+		tentativasLogin[chave] = t
+	}
+	t.falhas++
+	if t.falhas >= LoginMaxFalhas {
+		t.bloqueado = agora.Add(LoginBloqueio)
+		fmt.Printf("[cadena] login bloqueado por %s: %s\n", LoginBloqueio, chave)
+	}
+	// Limpeza simples para o mapa nao crescer sem limite
+	if len(tentativasLogin) > 10000 {
+		for k, v := range tentativasLogin {
+			if agora.Sub(v.primeira) > LoginJanela && (v.bloqueado.IsZero() || agora.After(v.bloqueado)) {
+				delete(tentativasLogin, k)
+			}
+		}
+	}
+}
+
+// LimparFalhasLogin zera a contagem depois de um login certo
+func LimparFalhasLogin(chave string) {
+	tentativasLoginMu.Lock()
+	defer tentativasLoginMu.Unlock()
+	delete(tentativasLogin, chave)
+}
