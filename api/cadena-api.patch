@@ -0,0 +1,86 @@
+<script setup lang="tsx">
+// CadenaTech: acessos em andamento, a partir da auditoria que o Cliente envia (abertura e fechamento de cada
+// conexao). Atualiza sozinha a cada 15 segundos.
+import { onMounted, onUnmounted, ref } from 'vue';
+import { NTag } from 'naive-ui';
+import type { DataTableColumns } from 'naive-ui';
+import { $t } from '@/locales';
+import { fetchConexoesAtivas, type CadenaConexao } from '@/service/api/cadena';
+
+defineOptions({ name: 'CadenaConexoes' });
+
+const lista = ref<CadenaConexao[]>([]);
+const carregando = ref(false);
+const atualizadoEm = ref('');
+let timer: ReturnType<typeof setInterval> | undefined;
+
+async function carregar() {
+  carregando.value = true;
+  const res = await fetchConexoesAtivas();
+  if (!res.error) {
+    lista.value = res.data || [];
+    atualizadoEm.value = new Date().toLocaleTimeString('pt-BR');
+  }
+  carregando.value = false;
+}
+
+function duracao(min: number) {
+  if (min < 1) return 'agora';
+  if (min < 60) return `${min} min`;
+  return `${Math.floor(min / 60)} h ${min % 60} min`;
+}
+
+const colunas: DataTableColumns<CadenaConexao> = [
+  {
+    key: 'tecnico',
+    title: 'Técnico',
+    minWidth: 180,
+    render: row => (row.tecnico_nome ? `${row.tecnico_nome} (${row.tecnico_id})` : row.tecnico_id || '—')
+  },
+  {
+    key: 'cliente',
+    title: 'Computador do cliente',
+    minWidth: 220,
+    render: row => `${row.hostname || 'sem nome'} — ID ${row.rustdesk_id}`
+  },
+  { key: 'usuario', title: 'Usuário no cliente', minWidth: 140, render: row => row.cliente || '—' },
+  {
+    key: 'tipo',
+    title: 'Tipo',
+    align: 'center',
+    render: row => <NTag type={row.tipo === 'Conectando' ? 'warning' : 'success'}>{row.tipo}</NTag>
+  },
+  { key: 'inicio', title: 'Início', align: 'center', minWidth: 160 },
+  { key: 'minutos', title: 'Duração', align: 'center', minWidth: 100, render: row => duracao(row.minutos) },
+  { key: 'ip', title: 'IP do técnico', align: 'center', minWidth: 130 }
+];
+
+onMounted(() => {
+  carregar();
+  timer = setInterval(carregar, 15000);
+});
+onUnmounted(() => timer && clearInterval(timer));
+</script>
+
+<template>
+  <NCard :bordered="false" size="small" class="card-wrapper">
+    <template #header>Acessos agora</template>
+    <template #header-extra>
+      <NSpace align="center">
+        <span v-if="atualizadoEm" class="text-12px opacity-70">atualizado às {{ atualizadoEm }}</span>
+        <NButton size="small" @click="carregar">
+          <template #icon>
+            <icon-mdi-refresh class="text-icon" :class="{ 'animate-spin': carregando }" />
+          </template>
+          {{ $t('common.refresh') }}
+        </NButton>
+      </NSpace>
+    </template>
+    <p class="pb-12px text-13px opacity-80">
+      Conexões abertas nos computadores dos clientes nas últimas 12 horas. Uma conexão some daqui quando o técnico
+      desconecta.
+    </p>
+    <NDataTable :columns="colunas" :data="lista" :loading="carregando" size="small" :row-key="row => row.id" :scroll-x="1150" />
+    <NEmpty v-if="!carregando && lista.length === 0" description="Nenhum acesso em andamento" class="pt-24px" />
+  </NCard>
+</template>
