diff --git a/backend/app/controller/api/cadena_catalogo.go b/backend/app/controller/api/cadena_catalogo.go
new file mode 100644
index 0000000..921e25a
--- /dev/null
+++ b/backend/app/controller/api/cadena_catalogo.go
@@ -0,0 +1,50 @@
+package api
+
+import (
+	"errors"
+	"rustdesk-api-server-pro/app/model"
+
+	"xorm.io/xorm"
+)
+
+// CadenaTech: permissao nos catalogos de enderecos.
+//   - Catalogo pessoal (shared = 0): so o dono, com controle total.
+//   - Catalogo compartilhado (shared = 1, criado no painel, user_id = 0): todos os tecnicos com a regra
+//     padrao do catalogo (rule) ou com a regra propria do tecnico em address_book_rule.
+// Regras: 0 sem acesso, 1 leitura, 2 leitura e escrita, 3 controle total.
+const (
+	RegraNenhuma = 0
+	RegraLeitura = 1
+	RegraEscrita = 2
+	RegraTotal   = 3
+)
+
+func regraNoCatalogo(db *xorm.Engine, user *model.User, ab *model.AddressBook) int {
+	if ab.Id == 0 || user == nil {
+		return RegraNenhuma
+	}
+	if !ab.Shared {
+		if ab.UserId == user.Id {
+			return RegraTotal
+		}
+		return RegraNenhuma
+	}
+	var r model.AddressBookRule
+	if has, _ := db.Where("ab_id = ? and user_id = ?", ab.Id, user.Id).Get(&r); has {
+		return r.Rule
+	}
+	return ab.Rule
+}
+
+// catalogoDoUsuario preenche ab com o catalogo de guid, se o tecnico tiver pelo menos regraMinima nele
+func catalogoDoUsuario(db *xorm.Engine, user *model.User, guid string, regraMinima int, ab *model.AddressBook) error {
+	has, err := db.Where("guid = ?", guid).Get(ab)
+	if err != nil {
+		return err
+	}
+	if !has || regraNoCatalogo(db, user, ab) < regraMinima {
+		*ab = model.AddressBook{}
+		return errors.New("sem permissao neste catalogo de enderecos")
+	}
+	return nil
+}
