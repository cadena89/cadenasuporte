@@ -0,0 +1,210 @@
+<script setup lang="tsx">
+// CadenaTech: catalogos de enderecos compartilhados entre os tecnicos. Cada catalogo tem uma permissao padrao
+// para todos e, se preciso, permissoes por tecnico. Os computadores entram pelo proprio programa Tecnico.
+import { onMounted, reactive, ref } from 'vue';
+import { NButton, NPopconfirm, NSpace, NTag } from 'naive-ui';
+import type { DataTableColumns } from 'naive-ui';
+import { $t } from '@/locales';
+import {
+  excluirCatalogo,
+  fetchCatalogos,
+  fetchTecnicos,
+  salvarCatalogo,
+  type CadenaCatalogo,
+  type CadenaTecnico
+} from '@/service/api/cadena';
+
+defineOptions({ name: 'CadenaCatalogos' });
+
+const regras = [
+  { label: 'Sem acesso', value: 0 },
+  { label: 'Só ver', value: 1 },
+  { label: 'Ver e editar', value: 2 },
+  { label: 'Controle total', value: 3 }
+];
+const corRegra: Record<number, 'default' | 'info' | 'success' | 'warning'> = {
+  0: 'default',
+  1: 'info',
+  2: 'success',
+  3: 'warning'
+};
+const nomeRegra = (r: number) => regras.find(x => x.value === r)?.label || String(r);
+
+const lista = ref<CadenaCatalogo[]>([]);
+const tecnicos = ref<CadenaTecnico[]>([]);
+const carregando = ref(false);
+const salvando = ref(false);
+const modal = ref(false);
+const form = reactive<CadenaCatalogo>({ id: 0, name: '', note: '', rule: 1, regras: [] });
+
+async function carregar() {
+  carregando.value = true;
+  const [c, t] = await Promise.all([fetchCatalogos(), fetchTecnicos()]);
+  if (!c.error) lista.value = c.data || [];
+  if (!t.error) tecnicos.value = t.data || [];
+  carregando.value = false;
+}
+
+function abrir(cat?: CadenaCatalogo) {
+  Object.assign(form, {
+    id: cat?.id || 0,
+    name: cat?.name || '',
+    note: cat?.note || '',
+    rule: cat ? cat.rule : 1,
+    regras: (cat?.regras || []).map(r => ({ user_id: r.user_id, rule: r.rule }))
+  });
+  modal.value = true;
+}
+
+function adicionarRegra() {
+  form.regras.push({ user_id: 0, rule: 2 });
+}
+
+async function salvar() {
+  if (!form.name.trim()) {
+    window.$message?.error($t('api.CatalogNameEmpty' as App.I18n.I18nKey));
+    return;
+  }
+  salvando.value = true;
+  const res = await salvarCatalogo({ ...form, regras: form.regras.filter(r => r.user_id > 0) });
+  salvando.value = false;
+  if (!res.error) {
+    window.$message?.success($t('api.CatalogSaved' as App.I18n.I18nKey));
+    modal.value = false;
+    await carregar();
+  }
+}
+
+async function excluir(cat: CadenaCatalogo) {
+  const res = await excluirCatalogo(cat.id);
+  if (!res.error) {
+    window.$message?.success($t('api.CatalogDeleted' as App.I18n.I18nKey));
+    await carregar();
+  }
+}
+
+const colunas: DataTableColumns<CadenaCatalogo> = [
+  { key: 'name', title: 'Catálogo', align: 'left', minWidth: 180 },
+  { key: 'note', title: 'Observação', align: 'left', minWidth: 180 },
+  { key: 'peers', title: 'Computadores', align: 'center', width: 120 },
+  {
+    key: 'rule',
+    title: 'Todos os técnicos',
+    align: 'center',
+    width: 150,
+    render: row => <NTag type={corRegra[row.rule]}>{nomeRegra(row.rule)}</NTag>
+  },
+  {
+    key: 'regras',
+    title: 'Exceções por técnico',
+    align: 'left',
+    minWidth: 220,
+    render: row =>
+      row.regras.length === 0 ? (
+        '—'
+      ) : (
+        <NSpace size="small">
+          {row.regras.map(r => (
+            <NTag size="small" type={corRegra[r.rule]}>
+              {`${r.name || r.username}: ${nomeRegra(r.rule)}`}
+            </NTag>
+          ))}
+        </NSpace>
+      )
+  },
+  {
+    key: 'acoes',
+    title: $t('common.action'),
+    align: 'center',
+    width: 170,
+    render: row => (
+      <NSpace justify="center">
+        <NButton size="small" type="success" onClick={() => abrir(row)}>
+          {$t('common.edit')}
+        </NButton>
+        <NPopconfirm
+          negativeText={$t('common.cancel')}
+          positiveText={$t('common.confirm')}
+          onPositiveClick={() => excluir(row)}
+        >
+          {{
+            default: () => 'Excluir o catálogo e todos os computadores dele?',
+            trigger: () => (
+              <NButton size="small" type="error">
+                {$t('common.delete')}
+              </NButton>
+            )
+          }}
+        </NPopconfirm>
+      </NSpace>
+    )
+  }
+];
+
+onMounted(carregar);
+</script>
+
+<template>
+  <div class="flex-col-stretch gap-16px">
+    <NCard :bordered="false" size="small" class="card-wrapper">
+      <template #header>Catálogos compartilhados</template>
+      <template #header-extra>
+        <NSpace wrap justify="end">
+          <NButton size="small" ghost type="primary" @click="abrir()">
+            <template #icon>
+              <icon-ic-round-plus class="text-icon" />
+            </template>
+            {{ $t('common.add') }}
+          </NButton>
+          <NButton size="small" @click="carregar">
+            <template #icon>
+              <icon-mdi-refresh class="text-icon" :class="{ 'animate-spin': carregando }" />
+            </template>
+            {{ $t('common.refresh') }}
+          </NButton>
+        </NSpace>
+      </template>
+      <p class="pb-12px text-13px opacity-80">
+        Catálogos que todos os técnicos veem no programa Técnico, na aba de catálogo de endereços. Os computadores são
+        incluídos pelo próprio programa, por quem tem permissão de editar.
+      </p>
+      <NDataTable :columns="colunas" :data="lista" :loading="carregando" size="small" :row-key="row => row.id" :scroll-x="1100" />
+    </NCard>
+
+    <NModal v-model:show="modal" preset="card" :title="form.id ? 'Editar catálogo' : 'Novo catálogo'" class="w-640px">
+      <NForm label-placement="top">
+        <NFormItem label="Nome">
+          <NInput v-model:value="form.name" placeholder="ex.: Clientes" maxlength="100" />
+        </NFormItem>
+        <NFormItem label="Observação">
+          <NInput v-model:value="form.note" placeholder="opcional" maxlength="255" />
+        </NFormItem>
+        <NFormItem label="Permissão de todos os técnicos">
+          <NSelect v-model:value="form.rule" :options="regras" />
+        </NFormItem>
+        <NFormItem label="Exceções por técnico (valem no lugar da permissão acima)">
+          <div class="w-full flex-col gap-8px">
+            <div v-for="(r, i) in form.regras" :key="i" class="flex gap-8px">
+              <NSelect
+                v-model:value="r.user_id"
+                class="flex-1"
+                placeholder="Técnico"
+                filterable
+                :options="tecnicos.map(t => ({ label: `${t.name || t.username} (${t.username})`, value: t.id }))"
+              />
+              <NSelect v-model:value="r.rule" class="w-170px" :options="regras" />
+              <NButton quaternary type="error" @click="form.regras.splice(i, 1)">Remover</NButton>
+            </div>
+            <NButton dashed size="small" @click="adicionarRegra">Adicionar exceção</NButton>
+          </div>
+        </NFormItem>
+      </NForm>
+      <template #footer>
+        <NSpace justify="end">
+          <NButton @click="modal = false">{{ $t('common.cancel') }}</NButton>
+          <NButton type="primary" :loading="salvando" @click="salvar">{{ $t('common.confirm') }}</NButton>
+        </NSpace>
+      </template>
+    </NModal>
+  </div>
+</template>
