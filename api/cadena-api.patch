diff --git a/backend/app/controller/admin/cadena.go b/backend/app/controller/admin/cadena.go
new file mode 100644
index 0000000..7829c14
--- /dev/null
+++ b/backend/app/controller/admin/cadena.go
@@ -0,0 +1,227 @@
+package admin
+
+// CadenaTech: telas do painel acrescentadas pelo CadenaTech.
+//   - /catalogs/*: catalogos de enderecos compartilhados (shared = 1, user_id = 0), com regra padrao
+//     para todos os tecnicos e regras por tecnico (address_book_rule).
+//   - /connections/active: acessos em andamento, a partir da auditoria de conexoes.
+
+import (
+	"encoding/json"
+	"strings"
+	"time"
+
+	"rustdesk-api-server-pro/app/model"
+	"rustdesk-api-server-pro/config"
+
+	"github.com/beevik/guid"
+	"github.com/kataras/iris/v12"
+	"github.com/kataras/iris/v12/mvc"
+)
+
+type CadenaController struct {
+	basicController
+}
+
+func (c *CadenaController) BeforeActivation(b mvc.BeforeActivation) {
+	b.Handle("GET", "/catalogs/list", "HandleCatalogos")
+	b.Handle("GET", "/catalogs/users", "HandleTecnicos")
+	b.Handle("POST", "/catalogs/save", "HandleSalvarCatalogo")
+	b.Handle("POST", "/catalogs/delete", "HandleExcluirCatalogo")
+	b.Handle("GET", "/connections/active", "HandleConexoesAtivas")
+}
+
+type regraForm struct {
+	UserId int `json:"user_id"`
+	Rule   int `json:"rule"`
+}
+
+type catalogoForm struct {
+	Id     int         `json:"id"`
+	Name   string      `json:"name"`
+	Note   string      `json:"note"`
+	Rule   int         `json:"rule"`
+	Regras []regraForm `json:"regras"`
+}
+
+func (c *CadenaController) HandleCatalogos() mvc.Result {
+	abs := make([]model.AddressBook, 0)
+	if err := c.Db.Where("shared = ?", true).Asc("name").Find(&abs); err != nil {
+		return c.Error(nil, err.Error())
+	}
+	list := make([]iris.Map, 0)
+	for _, ab := range abs {
+		peers, _ := c.Db.Where("ab_id = ?", ab.Id).Count(&model.Peer{})
+		regras := make([]model.AddressBookRule, 0)
+		_ = c.Db.Where("ab_id = ?", ab.Id).Find(&regras)
+		listaRegras := make([]iris.Map, 0)
+		for _, r := range regras {
+			var u model.User
+			if has, _ := c.Db.ID(r.UserId).Get(&u); !has {
+				continue
+			}
+			listaRegras = append(listaRegras, iris.Map{"user_id": r.UserId, "username": u.Username, "name": u.Name, "rule": r.Rule})
+		}
+		list = append(list, iris.Map{
+			"id":         ab.Id,
+			"guid":       ab.Guid,
+			"name":       ab.Name,
+			"note":       ab.Note,
+			"rule":       ab.Rule,
+			"peers":      peers,
+			"regras":     listaRegras,
+			"created_at": ab.CreatedAt.Format(config.TimeFormat),
+		})
+	}
+	return c.Success(list, "ok")
+}
+
+func (c *CadenaController) HandleTecnicos() mvc.Result {
+	users := make([]model.User, 0)
+	if err := c.Db.Where("status = 1").Asc("username").Find(&users); err != nil {
+		return c.Error(nil, err.Error())
+	}
+	list := make([]iris.Map, 0)
+	for _, u := range users {
+		list = append(list, iris.Map{"id": u.Id, "username": u.Username, "name": u.Name})
+	}
+	return c.Success(list, "ok")
+}
+
+func (c *CadenaController) HandleSalvarCatalogo() mvc.Result {
+	var form catalogoForm
+	if err := c.Ctx.ReadJSON(&form); err != nil {
+		return c.Error(nil, err.Error())
+	}
+	form.Name = strings.TrimSpace(form.Name)
+	if form.Name == "" {
+		return c.Error(nil, "CatalogNameEmpty")
+	}
+	if form.Rule < 0 || form.Rule > 3 {
+		return c.Error(nil, "CatalogRuleInvalid")
+	}
+	session := c.Db.NewSession()
+	defer session.Close()
+	if err := session.Begin(); err != nil {
+		return c.Error(nil, err.Error())
+	}
+	var ab model.AddressBook
+	if form.Id > 0 {
+		has, err := session.Where("id = ? and shared = ?", form.Id, true).Get(&ab)
+		if err != nil || !has {
+			_ = session.Rollback()
+			return c.Error(nil, "CatalogNotFound")
+		}
+		ab.Name, ab.Note, ab.Rule = form.Name, form.Note, form.Rule
+		if _, err := session.ID(ab.Id).Cols("name", "note", "rule").Update(&ab); err != nil {
+			_ = session.Rollback()
+			return c.Error(nil, err.Error())
+		}
+	} else {
+		ab = model.AddressBook{
+			UserId:  0,
+			Guid:    guid.New().String(),
+			Name:    form.Name,
+			Owner:   c.GetUser().Username,
+			Note:    form.Note,
+			Rule:    form.Rule,
+			MaxPeer: model.MaxPeer,
+			Shared:  true,
+		}
+		if _, err := session.Insert(&ab); err != nil {
+			_ = session.Rollback()
+			return c.Error(nil, err.Error())
+		}
+	}
+	if _, err := session.Where("ab_id = ?", ab.Id).Delete(&model.AddressBookRule{}); err != nil {
+		_ = session.Rollback()
+		return c.Error(nil, err.Error())
+	}
+	vistos := map[int]bool{}
+	for _, r := range form.Regras {
+		if r.UserId <= 0 || vistos[r.UserId] || r.Rule < 0 || r.Rule > 3 {
+			continue
+		}
+		vistos[r.UserId] = true
+		if _, err := session.Insert(&model.AddressBookRule{AbId: ab.Id, UserId: r.UserId, Rule: r.Rule}); err != nil {
+			_ = session.Rollback()
+			return c.Error(nil, err.Error())
+		}
+	}
+	if err := session.Commit(); err != nil {
+		return c.Error(nil, err.Error())
+	}
+	return c.Success(iris.Map{"id": ab.Id}, "CatalogSaved")
+}
+
+func (c *CadenaController) HandleExcluirCatalogo() mvc.Result {
+	var form catalogoForm
+	if err := c.Ctx.ReadJSON(&form); err != nil {
+		return c.Error(nil, err.Error())
+	}
+	var ab model.AddressBook
+	if has, _ := c.Db.Where("id = ? and shared = ?", form.Id, true).Get(&ab); !has {
+		return c.Error(nil, "CatalogNotFound")
+	}
+	session := c.Db.NewSession()
+	defer session.Close()
+	if err := session.Begin(); err != nil {
+		return c.Error(nil, err.Error())
+	}
+	for _, bean := range []interface{}{&model.Peer{}, &model.AddressBookTag{}, &model.AddressBookRule{}} {
+		if _, err := session.Where("ab_id = ?", ab.Id).Delete(bean); err != nil {
+			_ = session.Rollback()
+			return c.Error(nil, err.Error())
+		}
+	}
+	if _, err := session.ID(ab.Id).Delete(&model.AddressBook{}); err != nil {
+		_ = session.Rollback()
+		return c.Error(nil, err.Error())
+	}
+	if err := session.Commit(); err != nil {
+		return c.Error(nil, err.Error())
+	}
+	return c.Success(nil, "CatalogDeleted")
+}
+
+// HandleConexoesAtivas: conexoes registradas pelo Cliente (auditoria) ainda sem fechamento, das ultimas 12
+// horas (o que passar disso ficou aberto por queda do Cliente e nao conta como ativo)
+func (c *CadenaController) HandleConexoesAtivas() mvc.Result {
+	desde := time.Now().Add(-12 * time.Hour)
+	audits := make([]model.Audit, 0)
+	err := c.Db.Where("(closed_at IS NULL or closed_at < ?) and created_at >= ?", "1971-01-01", desde).
+		Desc("created_at").Find(&audits)
+	if err != nil {
+		return c.Error(nil, err.Error())
+	}
+	tipos := map[int]string{0: "Acesso remoto", 1: "Transferência de arquivos", 2: "Túnel TCP"}
+	list := make([]iris.Map, 0)
+	for _, a := range audits {
+		var d model.Device
+		_, _ = c.Db.Where("rustdesk_id = ?", a.RustdeskId).Get(&d)
+		tecnicoId, tecnicoNome := "", ""
+		var par []string
+		if json.Unmarshal([]byte(a.Peer), &par) == nil && len(par) > 0 {
+			tecnicoId = par[0]
+			if len(par) > 1 {
+				tecnicoNome = par[1]
+			}
+		}
+		tipo := tipos[a.Type]
+		if a.Peer == "" {
+			tipo = "Conectando"
+		}
+		list = append(list, iris.Map{
+			"id":           a.Id,
+			"rustdesk_id":  a.RustdeskId,
+			"hostname":     d.Hostname,
+			"cliente":      d.Username,
+			"tecnico_id":   tecnicoId,
+			"tecnico_nome": tecnicoNome,
+			"ip":           a.IP,
+			"tipo":         tipo,
+			"inicio":       a.CreatedAt.Format(config.TimeFormat),
+			"minutos":      int(time.Since(a.CreatedAt).Minutes()),
+		})
+	}
+	return c.Success(list, "ok")
+}
