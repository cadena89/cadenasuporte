+// CadenaTech: catalogos compartilhados e acessos em andamento (backend: app/controller/admin/cadena.go)
+import { request } from '../request';
+
+export interface CadenaRegra {
+  user_id: number;
+  username?: string;
+  name?: string;
+  rule: number;
+}
+
+export interface CadenaCatalogo {
+  id: number;
+  guid?: string;
+  name: string;
+  note: string;
+  rule: number;
+  peers?: number;
+  regras: CadenaRegra[];
+  created_at?: string;
+}
+
+export interface CadenaTecnico {
+  id: number;
+  username: string;
+  name: string;
+}
+
+export interface CadenaConexao {
+  id: number;
+  rustdesk_id: string;
+  hostname: string;
+  cliente: string;
+  tecnico_id: string;
+  tecnico_nome: string;
+  ip: string;
+  tipo: string;
+  inicio: string;
+  minutos: number;
+}
+
+export function fetchCatalogos() {
+  return request<CadenaCatalogo[]>({ url: '/catalogs/list' });
+}
+
+export function fetchTecnicos() {
+  return request<CadenaTecnico[]>({ url: '/catalogs/users' });
+}
+
+export function salvarCatalogo(data: CadenaCatalogo) {
+  return request({ url: '/catalogs/save', method: 'post', data });
+}
+
+export function excluirCatalogo(id: number) {
+  return request({ url: '/catalogs/delete', method: 'post', data: { id } });
+}
+
+export function fetchConexoesAtivas() {
+  return request<CadenaConexao[]>({ url: '/connections/active' });
+}
